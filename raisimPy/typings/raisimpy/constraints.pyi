from typing import Annotated

import numpy
from numpy.typing import NDArray


class PinConstraintDefinition:
    def __init__(self) -> None: ...

    @property
    def body1(self) -> str: ...

    @body1.setter
    def body1(self, arg: str, /) -> None: ...

    @property
    def body2(self) -> str: ...

    @body2.setter
    def body2(self, arg: str, /) -> None: ...

    @property
    def anchor(self) -> Annotated[NDArray[numpy.float64], dict(order='C')]: ...

    @anchor.setter
    def anchor(self, arg: Annotated[NDArray[numpy.float64], dict(order='C')], /) -> None: ...

class PinConstraint:
    def __init__(self, local_idx1: int, pos1_b: "raisim::Mat<3ul, 1ul>", local_idx2: int, pos2_b: "raisim::Mat<3ul, 1ul>") -> None: ...

    @property
    def pos1_b(self) -> Annotated[NDArray[numpy.float64], dict(order='C')]: ...

    @pos1_b.setter
    def pos1_b(self, arg: Annotated[NDArray[numpy.float64], dict(order='C')], /) -> None: ...

    @property
    def pos2_b(self) -> Annotated[NDArray[numpy.float64], dict(order='C')]: ...

    @pos2_b.setter
    def pos2_b(self, arg: Annotated[NDArray[numpy.float64], dict(order='C')], /) -> None: ...

    @property
    def pos1_w(self) -> Annotated[NDArray[numpy.float64], dict(order='C')]: ...

    @pos1_w.setter
    def pos1_w(self, arg: Annotated[NDArray[numpy.float64], dict(order='C')], /) -> None: ...

    @property
    def pos2_w(self) -> Annotated[NDArray[numpy.float64], dict(order='C')]: ...

    @pos2_w.setter
    def pos2_w(self, arg: Annotated[NDArray[numpy.float64], dict(order='C')], /) -> None: ...

    @property
    def localIdx1(self) -> int: ...

    @localIdx1.setter
    def localIdx1(self, arg: int, /) -> None: ...

    @property
    def localIdx2(self) -> int: ...

    @localIdx2.setter
    def localIdx2(self, arg: int, /) -> None: ...
