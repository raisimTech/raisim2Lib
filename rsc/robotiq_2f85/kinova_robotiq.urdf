<?xml version="1.0"?>
<!--
  Kinova Jaco arm with a fixed Robotiq 2F-85 wrist mount for RaiSim pick-and-place.
  The original Kinova three-finger hand and the Robotiq vertical lift are replaced
  by a lightweight tool flange. Only the six arm joints and the left knuckle are
  actuated; all five gripper followers retain their original mimic constraints.
  grasp_frame is a reference point near the closed fingertips, not an attachment
  constraint for the cube. Arm collisions use conservative primitive envelopes.

  Reuses the bundled BSD 3-Clause robot descriptions and their mesh assets:
  Copyright (c) 2017, Kinova Robotics inc. See ../kinova/LICENSE.
  Copyright (c) 2022, PickNik Robotics. See LICENSE in this directory.
  The complete redistribution conditions and disclaimers are retained in those
  license files, which must accompany this model and its mesh assets.
-->
<robot name="kinova_robotiq_2f85">
  <link name="world" />
