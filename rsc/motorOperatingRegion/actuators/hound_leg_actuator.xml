<?xml version="1.0"?>
<!--
  Sagittal leg actuator in the style of KAIST Hound, used for the hip (HFE) and the knee (KFE):
  the same DC motor as the abduction actuator behind a 10:1 reducer, on the 24 V bus.
  Both motors sit on the body. The knee reducer's ring gear turns with the thigh, so the knee motor
  also turns with the hip; the URDF declares that with a <coupling> on each knee <actuator>.
  Losses measured at the output (the joint): 0.02 Nm s/rad viscous damping, 0.3 Nm Coulomb friction.
-->
<actuator_model name="hound_leg" gear_ratio="10" output_damping="0.02" output_friction="0.3">
  <motor resistance="0.4" torque_constant="0.1" velocity_constant="10" bus_voltage="24" peak_torque="3"/>
</actuator_model>
