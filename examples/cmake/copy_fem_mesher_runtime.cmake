if(NOT EXISTS "${MESHER}")
    message(FATAL_ERROR "Native FEM mesher was not built: ${MESHER}")
endif()
get_filename_component(mesher_bin "${MESHER}" DIRECTORY)
get_filename_component(mesher_prefix "${mesher_bin}" DIRECTORY)
set(notices "${mesher_prefix}/share/raisim-fem-mesher")
if(NOT EXISTS "${notices}/licenses")
    message(FATAL_ERROR "The native FEM mesher has no license notices: ${notices}/licenses")
endif()
# Earlier meshers shipped Open CASCADE libraries and notices next to the helper.
file(REMOVE_RECURSE "${DESTINATION}/lib" "${DESTINATION}/share/raisim-fem-mesher")
file(GLOB stale "${DESTINATION}/bin/TK*.dll")
if(stale)
    file(REMOVE ${stale})
endif()
file(MAKE_DIRECTORY "${DESTINATION}/bin" "${DESTINATION}/share")
file(COPY "${MESHER}" DESTINATION "${DESTINATION}/bin")
file(COPY "${notices}" DESTINATION "${DESTINATION}/share")
