if(NOT EXISTS "${MESHER}")
    message(FATAL_ERROR "Native FEM mesher was not built: ${MESHER}")
endif()
get_filename_component(mesher_bin "${MESHER}" DIRECTORY)
get_filename_component(mesher_prefix "${mesher_bin}" DIRECTORY)
file(GLOB libraries "${mesher_prefix}/lib/libTK*.so*" "${mesher_prefix}/lib/libTK*.dylib")
file(GLOB dlls "${mesher_bin}/TK*.dll")
if(NOT libraries AND NOT dlls)
    message(FATAL_ERROR "Use an installed native FEM mesher with its shared CAD libraries")
endif()
file(MAKE_DIRECTORY "${DESTINATION}/bin" "${DESTINATION}/lib")
file(COPY "${MESHER}" ${dlls} DESTINATION "${DESTINATION}/bin")
if(libraries)
    file(COPY ${libraries} DESTINATION "${DESTINATION}/lib")
endif()
file(COPY "${mesher_prefix}/share/raisim-fem-mesher" DESTINATION "${DESTINATION}/share")
